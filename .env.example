# Copy this file to `.env` in the repo root before `docker compose up`.
# Do not quote values — docker-compose passes them literally.
# See backend/README.md for provider details.
#
# Gemini / Google Generative Language API (pydantic-ai reads GOOGLE_API_KEY first, then GEMINI_API_KEY).
# Put your real AI Studio key on at least one line — both may be the same string:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

LLM_MODEL=gemini-2.0-flash

# OpenAI alternative (comment out Gemini keys above or leave empty, then uncomment):
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
